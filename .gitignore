# Python
__pycache__/
*.pyc

# Live security rules — only security-rules.example.json belongs in the repo.
# Your real, machine-specific rules file must never be committed.
security-rules.json

# Runtime / session artifacts produced by the guard at work — NEVER commit these.
# They can contain machine-specific paths, task descriptions, agent ids and timestamps.
.sudo-overrides/
.sudo-overrides-pending/
.sudo-overrides-archiv/
.hook-dev-mode
.agent-audit/
actions.jsonl

# Editor / OS / backup noise
*.bak
*.bak-*
*.orig
.DS_Store

# Local Claude Code session state (if a clone ever lives under ~/.claude)
session-state.json

# Planungs-Graph des Guards. Er gehoert zum Hub-Projekt 0050-safety-guard und liegt
# dort unter projekte/0050-safety-guard/graph/ -- versioniert und gesichert. Hier lag
# er eine Zeit lang untrackt herum: nirgends gesichert, und sein Denk-Log enthaelt
# interne Pfade und Namen, die in einem oeffentlichen Repo nichts zu suchen haben.
# Nicht wieder hierher legen.
graph/
tests/benches/
