{
  "_comment_blocked_patterns": "Regex patterns. The pipe | must be escaped (otherwise it acts as an OR and matches false positives). The rm patterns use word boundaries so that /home/... does not match.",
  "blocked_patterns": [
    "rm\\s+-rf?\\s+/(\\s|$)",
    "rm\\s+-rf?\\s+~(\\s|$|/\\*)",
    "rm\\s+-rf?\\s+/\\*",
    "rm\\s+-rf?\\s+\\.(\\s|$)",
    "rm\\s+-rf?\\s+\\$HOME(\\s|$|/\\*)",
    "chmod\\s+777",
    "chmod\\s+-R\\s+777",
    "\\bmkfs\\b",
    "\\bdd\\s+if=.*\\s+of=/dev/(sd|nvme|hd)",
    "> /dev/sd",
    ":\\(\\)\\{ :\\|:& \\};:",
    "curl\\s+[^|]*\\|\\s*sh",
    "curl\\s+[^|]*\\|\\s*bash",
    "wget\\s+[^|]*\\|\\s*sh",
    "wget\\s+[^|]*\\|\\s*bash",
    "eval.*base64",
    "python.*-c.*import.*os.*system",
    "chown -R.*(/etc|/usr|/var|/lib|/bin|/sbin|/boot)",
    "chmod -R.*(/etc|/usr|/var|/lib|/bin|/sbin|/boot)",
    "chgrp -R.*(/etc|/usr|/var|/lib|/bin|/sbin|/boot)"
  ],
  "_comment_owner_only_commands": "Commands that ONLY the owner may run via ! (which bypasses the guard). AI bash calls are hard-blocked here -- otherwise the AI could grant itself overrides (grant-override) or lift the hook self-protection (hook-dev-mode). Matched as a whole word.",
  "owner_only_commands": [
    "grant-override",
    "hook-dev-mode"
  ],
  "_comment_blocked_git_ops": "Git safety checks: never to be bypassed by an override.",
  "blocked_git_ops": [
    "git\\s+reset\\s+--hard",
    "git\\s+push\\s+(-f|--force(-with-lease)?)(\\s|$)",
    "git\\s+commit.*--no-verify",
    "git\\s+commit\\s+.*--amend",
    "git\\s+add\\s+(-A|--all)(\\s|$)",
    "git\\s+add\\s+\\.(\\s|$)",
    "git\\s+config\\s+(?!(--get|--list|-l)\\b)"
  ],
  "blocked_paths_write": [
    "~/.ssh",
    "~/.gnupg",
    "/etc/passwd",
    "/etc/shadow",
    "/etc/sudoers",
    "/etc/fstab",
    "/boot",
    "/usr/bin",
    "/usr/sbin",
    "/usr/lib",
    "/sbin",
    "/bin"
  ],
  "allowed_sudo": [
    "apt",
    "apt-get",
    "systemctl",
    "ufw",
    "docker",
    "chown",
    "chmod",
    "mkdir",
    "cp",
    "mv",
    "tee",
    "cat"
  ],
  "require_confirmation": [
    "pip install",
    "pnpm add",
    "npm install",
    "apt install",
    "apt-get install",
    "cargo install",
    "go install"
  ],
  "protected_reads": {
    "always_allowed": [
      "~/.ssh/config",
      "~/.ssh/known_hosts",
      "~/.ssh/authorized_keys",
      "~/.ssh/*.pub"
    ],
    "require_override_1": [
      "~/.ssh/id_",
      "~/.aws/credentials",
      "~/.aws/config",
      "~/.npmrc",
      "~/.docker/config.json",
      "~/.gnupg/"
    ],
    "always_blocked_reads": [
      "/etc/shadow",
      "/etc/gshadow"
    ],
    "_comment_env_files": ".env files are never accessible via the Read tool. Reading requires an override level 1+.",
    "env_files_require_override_1": [
      ".env",
      ".env.local",
      ".env.development",
      ".env.production"
    ]
  },
  "blocked_bash_patterns_force_push": [
    "git push.*--force.*\\b(main|master)\\b",
    "git push.*-f .*\\b(main|master)\\b",
    "git push --force-with-lease.*\\b(main|master)\\b"
  ],
  "prompt_injection_keywords": [
    "ignore previous",
    "ignore all",
    "disregard",
    "new instructions",
    "system prompt",
    "you are now",
    "forget everything",
    "override",
    "jailbreak",
    "DAN",
    "do anything now"
  ],
  "_comment_mcp_policy": "MCP tool protection (tool_name = mcp__<server>__<tool>). gate_servers: always require override 1+. safe_servers: allowed. Otherwise: tool verb starting with a read_verb_prefix = allowed (read-only), everything else requires override 1+ (default-deny for writes). Override level 1+ lifts the gate.",
  "mcp_policy": {
    "gate_servers": ["postgres"],
    "safe_servers": ["context7", "sequential-thinking"],
    "read_verb_prefixes": ["get", "list", "search", "read", "view", "status", "preview", "describe", "fetch"]
  },
  "_comment_docker": "Docker/Podman catastrophic flags -- ALWAYS blocked (no override), like blocked_patterns. The hook unions these onto a hardcoded fallback, so they fire even with a missing rules file. Bind-mounts onto self-protected or blocked_paths_write paths are handled by the hook directly (it reuses SELF_PROTECT_PATHS / blocked_paths_write), so no path config is needed here.",
  "docker": {
    "blocked_flags": [
      "--privileged",
      "/var/run/docker.sock", "/run/docker.sock",
      "--pid=host", "--pid host",
      "--network=host", "--network host", "--net=host", "--net host",
      "--ipc=host", "--ipc host",
      "--uts=host", "--uts host",
      "--cap-add=ALL", "--cap-add ALL",
      "--cap-add=SYS_ADMIN", "--cap-add SYS_ADMIN",
      "--security-opt=seccomp=unconfined", "seccomp=unconfined",
      "apparmor=unconfined"
    ]
  }
}
